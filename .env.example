# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# YouTube Data API v3 key
# Get one at: https://console.developers.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional: Gemini-powered messages. Without it, deterministic local
# personalization is used, so the workflow remains runnable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
USE_GEMINI=false

# Email sending. Keep DRY_RUN=true for safe demonstrations; it logs simulated
# sends without contacting anyone. Use an app password, never your main password.
DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
SEND_DELAY=3
